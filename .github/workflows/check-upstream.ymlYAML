name: Check Upstream NaiLink

on:
  schedule:
    - cron: '0 2 * * *'
  workflow_dispatch:
    inputs:
      force:
        description: '強制重建已有版本'
        type: boolean
        default: false
      cpu:
        description: '構建架構'
        type: choice
        default: 'x86_64'
        options:
          - x86_64
          - arm64
          - both

permissions:
  contents: write
  actions: write

jobs:
  check-and-dispatch:
    runs-on: ubuntu-24.04
    steps:
      - name: Find latest upstream tag and dispatch builds
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          FORCE: ${{ inputs.force || false }}
          CPU_INPUT: ${{ inputs.cpu || 'x86_64' }}
        run: |
          set -euo pipefail
          REPO="${{ github.repository }}"

          TAG=$(gh api "repos/slobys/NaiLink/tags?per_page=50" \
            --jq '[.[].name | select(startswith("openwrt-v"))][0]')
          if [ -z "$TAG" ] || [ "$TAG" = "null" ]; then
            echo "No openwrt-v* tag on upstream"
            exit 1
          fi
          VER="${TAG#openwrt-v}"
          echo "Upstream tag=$TAG version=$VER"

          if [ "$CPU_INPUT" = "both" ]; then
            CPUS="x86_64 arm64"
          else
            CPUS="$CPU_INPUT"
          fi

          DISPATCHED=0
          for CPU in $CPUS; do
            REL_TAG="v${VER}-${CPU}"
            ASSET="nailink-${VER}-${CPU}.tar.gz"
            BUILD=false

            if [ "$FORCE" = "true" ]; then
              BUILD=true
            elif ! gh release view "$REL_TAG" --repo "$REPO" >/dev/null 2>&1; then
              BUILD=true
            elif ! gh release view "$REL_TAG" --repo "$REPO" --json assets \
                --jq '.assets[].name' | grep -qx "$ASSET"; then
              BUILD=true
            else
              echo "Skip $REL_TAG (already has $ASSET)"
            fi

            if [ "$BUILD" = "true" ]; then
              echo "Dispatch build-nailink: $TAG / $VER / $CPU"
              gh workflow run build-nailink.yml \
                --repo "$REPO" \
                -f nailink_ref="$TAG" \
                -f version="$VER" \
                -f cpu="$CPU"
              DISPATCHED=$((DISPATCHED + 1))
            fi
          done

          echo "Dispatched jobs: $DISPATCHED"
